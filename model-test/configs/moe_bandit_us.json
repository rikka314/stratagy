{
  "schema_version": "1.0",
  "name": "moe_bandit_us",
  "phase": "F",
  "market": "US",
  "panel_output_dir": "model-test/outputs/moe_baseline_us",
  "phase_e_output_dir": "model-test/outputs/moe_online_us",
  "output_subdir": "moe_bandit_us",
  "random_seed": 42,
  "training_scope": "market_specific",
  "cross_market_policy": "ablation_only",
  "primary_horizon_days": 20,
  "return_field": "strategy_return",
  "cost_treatment": "source_net_no_recharge",
  "feedback_mode": "selected_action_only",
  "research_only": true,
  "context": {
    "feature_columns": [
      "market_return_5",
      "state_market_regime_id_20",
      "target_position"
    ]
  },
  "bandit": {
    "algorithms": ["linucb", "contextual_thompson"],
    "linucb_alphas": [0.25, 0.75],
    "thompson_scales": [0.25, 0.75],
    "ridge_lambda": 1.0,
    "observation_variance": 0.0004,
    "reward_clip": 0.05,
    "incremental_action_switch_cost_bps": 0.0
  }
}
