    "n_estimators": 200,
    "learning_rate": 0.05,
    "num_leaves": 15,
    "min_child_samples": 20,
    "n_jobs": 1,
    "minimum_train_rows": 100,
    "device_type": "cpu"
  },
  "gating": {
    "temperature": 0.05,
    "max_risk_expert_weight": 0.4,
    "smoothing_alpha": 0.35,
    "cash_expert_id": "cash"
  }
}
