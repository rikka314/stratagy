{
  "schema_version": "1.1",
  "name": "moe_v2_cn_a",
  "phase": "D",
  "market": "CN_A",
  "panel_output_dir": "model-test/outputs/moe_baseline_cn_a",
  "phase_c_output_dir": "model-test/outputs/moe_v1_cn_a",
  "output_subdir": "moe_v2_cn_a",
  "random_seed": 42,
  "training_scope": "market_specific",
  "cross_market_policy": "ablation_only",
  "primary_horizon_days": 20,
  "return_field": "strategy_return",
  "cost_treatment": "source_net_no_recharge",
  "model": {
    "n_estimators": 200,
    "learning_rate": 0.05,
    "num_leaves": 15,
    "min_child_samples": 20,
    "n_jobs": 1,
    "minimum_train_rows": 100,
    "device_type": "cpu"
  },
  "quantiles": {
    "lower": 0.2,
    "median": 0.5
  },
  "gating": {
    "temperature": 0.05,
    "max_risk_expert_weight": 0.4,
    "smoothing_alpha": 0.35,
    "cash_expert_id": "cash"
  },
  "uncertainty": {
    "gamma": 0.5,
    "confidence_width_threshold": 0.04,
    "disagreement_std_threshold": 0.025,
    "ood_max_abs_zscore": 5.0
  },
  "fallback": {
    "low_confidence_policy": "cash",
    "high_disagreement_policy": "equal_weight",
    "out_of_distribution_policy": "cash"
  },
  "risk": {
    "max_weight_change": 0.15,
    "max_portfolio_turnover": 0.12,
    "minimum_holding_days": 3,
    "position_active_threshold": 0.05,
    "drawdown_trigger": 0.1,
    "drawdown_risk_scale": 0.5
  },
  "ablation": {
    "temperatures": [0.025, 0.05, 0.1],
    "max_risk_expert_weights": [0.3, 0.4],
    "smoothing_alphas": [0.35, 0.65]
  }
}
